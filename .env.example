# Copy to .env.local for local dev, or .env for docker compose.

# --- Database -----------------------------------------------------------
POSTGRES_USER=pyramide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pyramide
# In docker compose, host is the service name "postgres". For local dev
# without Docker, use "localhost".
DATABASE_URL=postgresql://pyramide:change-me@localhost:5432/pyramide

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# --- Mail (used for verification, password reset, challenge notifications) -
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tennis-Pyramide <no-reply@example.com>"

# --- App --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Tennis-Forderungspyramide"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed script only — creates the very first admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
